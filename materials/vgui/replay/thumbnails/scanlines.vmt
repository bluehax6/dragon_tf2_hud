"UnlitGeneric"
{
	"$translucent" "1"
	"$baseTexture"  "vgui/replay/thumbnails/scanlines"
	"$alpha" "1"
	"$vertexalpha" "1"	
	"$vertexcolor" "1"
	"$no_fullbright" "1"
	"$ignorez" "1"
	"%keywords" "tf"

	"Proxies"
	{	
		"TextureScroll"
		{
		    "texturescrollvar" "$basetexturetransform"
		    "texturescrollrate" -0.075
		    "texturescrollangle" 90
		}
	}
}

